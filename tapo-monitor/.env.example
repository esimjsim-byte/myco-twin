TAPO_EMAIL=you@example.com
TAPO_PASSWORD=your-tapo-password

# H100 허브 IP
HUB_IP=192.168.0.100
# 환풍기 (fan) plug
PLUG_IP_1=192.168.0.101
# 가습기 (humidifier) plug
PLUG_IP_2=192.168.0.102

# 전역 기본 임계값 (구역별 값이 없으면 여기로 fallback)
TEMP_MAX=28
TEMP_MIN=10
HUMID_MAX=100
HUMID_MIN=60

POLL_INTERVAL_MS=10000
MIN_TOGGLE_INTERVAL_MS=30000
DASHBOARD_PORT=3000

# 구역 설정 (최대 ZONE_COUNT 만큼 SENSOR_<id>_* 를 읽음)
ZONE_COUNT=9

# 구역별 이름과 임계값 (TEMP/HUMID 값은 빈 칸이면 전역값 사용)
SENSOR_1_NAME=1구역
SENSOR_1_TEMP_MAX=28
SENSOR_1_TEMP_MIN=18
SENSOR_1_HUMID_MAX=95
SENSOR_1_HUMID_MIN=50
SENSOR_2_NAME=2구역
SENSOR_3_NAME=3구역
SENSOR_4_NAME=4구역
SENSOR_5_NAME=5구역
SENSOR_6_NAME=6구역
SENSOR_7_NAME=7구역
SENSOR_8_NAME=8구역
SENSOR_9_NAME=9구역

# PLC (Modbus TCP)
PLC_IP=192.168.0.50
PLC_PORT=502
PLC_UNIT_ID=1
PLC_COIL_FCU=1
PLC_COIL_HUMIDIFIER=2
PLC_COIL_VENTILATION=3
